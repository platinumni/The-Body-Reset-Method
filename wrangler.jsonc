// The Body Regeneration Method — Cloudflare Workers config.
// Top level = local development and tests. "staging" = test site. "production" = live site.
// Bindings are NOT inherited by environments, so each one lists its own.
// Secrets are never stored here: use `wrangler secret put NAME --env <env>`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bodyregen-dev",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // CSS, SVG and font files are bundled into the Worker (served by src/routes/assets.ts).
  "rules": [
    { "type": "Text", "globs": ["**/*.css", "**/*.svg"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.woff2", "**/*.png"], "fallthrough": true }
  ],
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "development",
    "SITE_NAME": "The Body Regeneration Method",
    "SITE_URL": "http://localhost:8787",
    "EMAIL_FROM": "The Body Regeneration Method <onboarding@resend.dev>"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "bodyregen-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BACKUPS", "bucket_name": "bodyregen-backups-dev" },
    { "binding": "MEDIA", "bucket_name": "bodyregen-media-dev" }
  ],
  "triggers": { "crons": ["0 3 * * SUN", "0 6 * * *"] },

  "env": {
    "staging": {
      "name": "bodyregen-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "SITE_NAME": "The Body Regeneration Method",
        "SITE_URL": "https://bodyregen-staging.michaeljmarden.workers.dev",
        // Resend's shared test sender: only delivers to the Resend account owner's own address.
        "EMAIL_FROM": "The Body Regeneration Method <onboarding@resend.dev>",
        // Growth engine (test). The reporting key is a secret: GROWTH_ENGINE_KEY.
        "GROWTH_ENGINE_URL": "https://engine-staging.michaeljmarden.workers.dev/api/events"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "bodyregen-staging", "database_id": "21f8e44a-bae4-499a-bacc-7417d7efebe5", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "BACKUPS", "bucket_name": "bodyregen-backups-staging" },
        { "binding": "MEDIA", "bucket_name": "bodyregen-media-staging" }
      ],
      "triggers": { "crons": ["0 3 * * SUN", "0 6 * * *", "5 * * * *"] }
    }
    // "production" is added at go-live (Step 9), once the domain is bought and you give the go-ahead.
  }
}
